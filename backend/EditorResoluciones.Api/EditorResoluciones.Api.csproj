<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EditorResoluciones.Dominio\EditorResoluciones.Dominio.csproj" />
    <ProjectReference Include="..\EditorResoluciones.Infraestructura\EditorResoluciones.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datos de prueba iniciales: se publican junto con la API. -->
    <Content Update="DatosSemilla\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Datos en ejecución: no forman parte del código ni de la publicación. -->
    <Content Remove="Data\**" />
    <None Remove="Data\**" />
  </ItemGroup>

</Project>
